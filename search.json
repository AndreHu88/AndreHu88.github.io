---
layout: null
---
[
{% for post in site.posts %}
  {
    "title": {{ post.title | jsonify }},
    "url": {{ post.url | prepend: site.baseurl | jsonify }},
    "date": {{ post.date | date: "%Y-%m-%d" | jsonify }},
    "tags": {{ post.tags | join: " " | jsonify }},
    "body": {{ post.content | strip_html | strip_newlines | replace: '"', '' | truncate: 360 | jsonify }},
    "source": "博客"
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
{% if site.posts.size > 0 and site.data.tools.size > 0 %},{% endif %}
{% for tool in site.data.tools %}
  {
    "title": {{ tool.title | jsonify }},
    "url": {{ "/tools/" | append: tool.slug | append: "/" | prepend: site.baseurl | jsonify }},
    "date": "",
    "tags": {{ tool.keywords | jsonify }},
    "body": {{ tool.summary | jsonify }},
    "source": "工具"
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
